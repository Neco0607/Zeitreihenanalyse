# ─── Python ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.installed.cfg
*.egg
.eggs/

# ─── Virtual Environments ───────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ─── Environment Variables ──────────────────────────────────────────
.env
.env.local

# ─── Jupyter ────────────────────────────────────────────────────────
.ipynb_checkpoints/
*-checkpoint.ipynb

# ─── IDE ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─── OS ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Daten (große Files ausschließen, .gitkeep behalten) ────────────
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# ─── Modelle ────────────────────────────────────────────────────────
*.pkl
*.joblib
*.h5

# ─── Reports (CSVs vom Pipeline-Run, behalten) ──────────────────────
# CSV-Outputs bleiben drin → Prof sieht Ergebnisse direkt
# reports/*.csv NICHT ignorieren

# ─── Tests / Coverage ───────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ─── Tooling ────────────────────────────────────────────────────────
.ruff_cache/
.mypy_cache/

# ─── Logs ───────────────────────────────────────────────────────────
*.log
logs/
